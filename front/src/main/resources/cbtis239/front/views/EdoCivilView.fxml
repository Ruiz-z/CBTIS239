<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.EdoCivilController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:10 14;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Estado Civil" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="24" vgap="16">
            <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="280" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <VBox alignment="TOP_CENTER" spacing="20" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <ImageView fitWidth="150" preserveRatio="true">
                    <image>
                        <!-- Coloca tu imagen en: resources/main/cbtis239/front/EdoCivillogo.png -->
                        <Image url="@/cbtis239/front/EdoCivillogo.png" />
                    </image>
                </ImageView>  
                
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    
                    <Label text="Nombre estado civil:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnAgregar" onAction="#onAgregar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar" />
                    <Button fx:id="btnModificar" onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: White; -fx-font-weight: bold; " text="Modificar" />
                    <Button fx:id="btnEliminar" onAction="#onEliminar" style="-fx-background-color:#800000; -fx-text-fill:white; -fx-font-weight:bold;" text="Eliminar" />
                    <Button fx:id="btnLimpiar" onAction="#limpiar" style="-fx-background-color:#800000; -fx-text-fill: white; -fx-font-weight:bold;" text="Limpiar" />
                </HBox>

            </VBox>

            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-weight:bold;" text="Estados Civiles :" />
                <TableView fx:id="tabla" prefHeight="360">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="500" text="Nombre" />
                        </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:10 18;">
            <Button onAction="#onVolverMenu" style="-fx-background-color:#800000; -fx-text-fill:white; -fx-font-weight:bold;" text="Regresar al menú" />
        </HBox>
    </bottom>
</BorderPane>
