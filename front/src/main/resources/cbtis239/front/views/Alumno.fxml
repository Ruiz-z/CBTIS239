<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.AlumnoController">

    <top>
        <Label text="Alumno"
               style="-fx-background-color:#7a0a0a;-fx-text-fill:white;-fx-font-size:20px;-fx-padding:10 0 10 0;"
               maxWidth="Infinity" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <HBox spacing="24">
                <!-- Columna izquierda: Foto y firma -->
                <VBox spacing="24" alignment="TOP_CENTER">
                    <VBox spacing="8" alignment="CENTER">
                        <StackPane prefWidth="180" prefHeight="180">
                            <ImageView fx:id="imgFoto" fitWidth="160" fitHeight="160" preserveRatio="true"/>
                        </StackPane>
                        <Button text="Subir Fotografía" onAction="#onSubirFoto"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER">
                        <StackPane prefWidth="180" prefHeight="120">
                            <ImageView fx:id="imgFirma" fitWidth="180" fitHeight="90" preserveRatio="true"/>
                        </StackPane>
                        <Button text="Subir Firma" onAction="#onSubirFirma"/>
                    </VBox>
                </VBox>

                <!-- Formulario -->
                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- fila 0 -->
                    <Label text="Matrícula:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtMatricula" promptText="Escribe y presiona Enter"
                               onAction="#onBuscarMatricula"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Estatus:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbEstatus" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <!-- fila 1 -->
                    <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Apellido Paterno:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtPaterno" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <!-- fila 2 -->
                    <Label text="Apellido Materno:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtMaterno" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="CURP:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCurp" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <!-- fila 3 -->
                    <Label text="Edo. Civil:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbEdoCivil" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Género:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbGenero" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                    <!-- fila 4 -->
                    <Label text="Correo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCorreo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="NSS:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtNss" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

                    <!-- fila 5 -->
                    <Label text="Fecha inscripción:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpFechaInsc" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Semestre:" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbSemestre" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

                    <!-- fila 6 -->
                    <Label text="Periodo:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbPeriodo" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label text="Especialidad:" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbEspecialidad" onAction="#onEspecialidadChange"
                              GridPane.rowIndex="6" GridPane.columnIndex="3"/>

                    <!-- fila 7 -->
                    <Label text="Grupo:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbGrupo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    <Label text="Calle:" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCalle" GridPane.rowIndex="7" GridPane.columnIndex="3"/>

                    <!-- fila 8 -->
                    <Label text="Número:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNumero" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                    <Label text="Colonia:" GridPane.rowIndex="8" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtColonia" GridPane.rowIndex="8" GridPane.columnIndex="3"/>

                    <!-- fila 9 -->
                    <Label text="Localidad:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtLocalidad" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                    <Label text="Municipio:" GridPane.rowIndex="9" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtMunicipio" GridPane.rowIndex="9" GridPane.columnIndex="3"/>

                    <!-- fila 10 -->
                    <Label text="Tel. Padre:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCelPadre" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
                    <Label text="Tel. Madre:" GridPane.rowIndex="10" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCelMadre" GridPane.rowIndex="10" GridPane.columnIndex="3"/>
                </GridPane>
            </HBox>

            <!-- Tabla -->
            <VBox spacing="8">
                <Label text="Alumnos"/>
                <TitledPane text="Alumnos">
                    <content>
                        <TableView fx:id="tblAlumnos" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="120"/>
                                <TableColumn fx:id="colNombre"   text="Nombre"    prefWidth="220"/>
                                <TableColumn fx:id="colSemestre" text="Semestre"  prefWidth="90"/>
                                <TableColumn fx:id="colGrupo"    text="Grupo"     prefWidth="120"/>
                            </columns>
                        </TableView>
                    </content>
                </TitledPane>


            </VBox>

            <!-- Botones -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="Guardar" onAction="#onGuardar"
                        style="-fx-background-color:#8b0000;-fx-text-fill:white;"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Volver al Menú" onAction="#onVolver"/>
                <Button text="Cancelar" onAction="#onCancelar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
