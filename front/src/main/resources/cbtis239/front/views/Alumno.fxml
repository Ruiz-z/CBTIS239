<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.AlumnoController">

    <top>
        <Label maxWidth="Infinity" style="-fx-background-color:#7a0a0a;-fx-text-fill:white;-fx-font-size:20px;-fx-padding:10 0 10 0;" text="Alumno" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <HBox spacing="24">
                <!-- Columna izquierda: Foto y firma -->
                <VBox alignment="TOP_CENTER" spacing="24">
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane prefHeight="180" prefWidth="180">
                            <ImageView fx:id="imgFoto" fitHeight="180" fitWidth="180" pickOnBounds="true" preserveRatio="true" smooth="true" style="-fx-opacity: 0.98;" />
                        </StackPane>
                        <Button onAction="#onSubirFoto" style="-fx-background-color: #800000;" text="Subir Fotografía" textFill="WHITE" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane prefHeight="120" prefWidth="180">
                            <ImageView fx:id="imgFirma" fitHeight="90" fitWidth="180" preserveRatio="true" />
                        </StackPane>
                        <Button onAction="#onSubirFirma" style="-fx-background-color: #800000;" text="Subir Firma" textFill="WHITE" />
                    </VBox>
                </VBox>

                <!-- Formulario -->
                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="110" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints halignment="RIGHT" minWidth="110" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <!-- fila 0 -->
                    <Label text="Matrícula:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtMatricula" onAction="#onBuscarMatricula" promptText="Escribe y presiona Enter" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label text="Estatus:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <ComboBox fx:id="cmbEstatus" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <!-- fila 1 -->
                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label text="Apellido Paterno:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="txtPaterno" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <!-- fila 2 -->
                    <Label text="Apellido Materno:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtMaterno" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label text="CURP:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <TextField fx:id="txtCurp" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                    <!-- fila 3 -->
                    <Label text="Edo. Civil:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cmbEdoCivil" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Label text="Género:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cmbGenero" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                    <!-- fila 4 -->
                    <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    <Label text="NSS:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                    <TextField fx:id="txtNss" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                    <!-- fila 5 -->
                    <Label text="Fecha inscripción:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <DatePicker fx:id="dpFechaInscripcion" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    <Label text="Semestre:" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                    <ComboBox fx:id="cmbSemestre" GridPane.columnIndex="3" GridPane.rowIndex="5" />

                    <!-- fila 6 -->
                    <Label text="Periodo:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <ComboBox fx:id="cmbPeriodo" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    <Label text="Especialidad:" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                    <ComboBox fx:id="cmbEspecialidad" onAction="#onEspecialidadChange" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                    <!-- fila 7 -->
                    <Label text="Grupo:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <ComboBox fx:id="cmbGrupo" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                    <Label text="Calle:" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                    <TextField fx:id="txtCalle" GridPane.columnIndex="3" GridPane.rowIndex="7" />

                    <!-- fila 8 -->
                    <Label text="Número:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <TextField fx:id="txtNumero" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                    <Label text="Colonia:" GridPane.columnIndex="2" GridPane.rowIndex="8" />
                    <TextField fx:id="txtColonia" GridPane.columnIndex="3" GridPane.rowIndex="8" />

                    <!-- fila 9 -->
                    <Label text="Localidad:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                    <TextField fx:id="txtLocalidad" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                    <Label text="Municipio:" GridPane.columnIndex="2" GridPane.rowIndex="9" />
                    <TextField fx:id="txtMunicipio" GridPane.columnIndex="3" GridPane.rowIndex="9" />

                    <!-- fila 10 -->
                    <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                    <TextField fx:id="txtEstado" GridPane.columnIndex="1" GridPane.rowIndex="10" />
                    <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="10" />
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="10" />
                    <!-- fila 11 -->
                    <Label text="Tel. Padre:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
                    <TextField fx:id="txtCelPadre" GridPane.columnIndex="1" GridPane.rowIndex="11" />
                    <Label text="Tel. Madre:" GridPane.columnIndex="2" GridPane.rowIndex="11" />
                    <TextField fx:id="txtCelMadre" GridPane.columnIndex="3" GridPane.rowIndex="11" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </HBox>

            <!-- Tabla -->
            <VBox spacing="8">
                <Label text="Alumnos" />
                <TitledPane text="Alumnos">
                    <content>
                        <TableView fx:id="tblAlumnos" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colMatricula" prefWidth="120" text="Matrícula" />
                                <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                                <TableColumn fx:id="colSemestre" prefWidth="90" text="Semestre" />
                                <TableColumn fx:id="colGrupo" prefWidth="120" text="Grupo" />
                            </columns>
                        </TableView>
                    </content>
                </TitledPane>


            </VBox>

            <!-- Botones -->
            <HBox alignment="CENTER" spacing="12">
                <Button onAction="#onGuardar" style="-fx-background-color:#8b0000;-fx-text-fill:white;" text="Guardar" />
                <Button onAction="#onEliminar" style="-fx-background-color: #800000;" text="Eliminar" textFill="#f8f8f8" />
                <Button onAction="#onVolver" style="-fx-background-color: #800000;" text="Volver al Menú" textFill="#fcfcfc" />
                <Button onAction="#onCancelar" style="-fx-background-color: #800000;" text="Cancelar" textFill="WHITE" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
