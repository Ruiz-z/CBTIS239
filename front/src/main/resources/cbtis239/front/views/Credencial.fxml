<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700" prefWidth="1200" stylesheets="/cbtis239/front/css/Credencial.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.CredencialController">

    <!-- ===== TÍTULO ===== -->
    <top>
        <VBox alignment="CENTER" spacing="5">
            <children>
                <Label text="Credencialización">
                    <font>
                        <Font size="28" />
                    </font>
                </Label>
                <Label text="CENTRO DE BACHILLERATO TECNOLÓGICO industrial y de servicios No. 239" />
            </children>
            <padding>
                <Insets bottom="10" left="0" right="0" top="10" />
            </padding>
        </VBox>
    </top>

    <!-- ===== CONTENIDO PRINCIPAL ===== -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="40" right="40" top="20" />
            </padding>
            <children>

                <!-- Primera fila: foto + datos -->
                <HBox spacing="40">
                    <children>

                        <!-- Foto del alumno (solo vista) -->
                        <VBox spacing="10">
                            <children>
                                <ImageView fx:id="imgAlumno" fitHeight="280" fitWidth="220" preserveRatio="true" smooth="true" style="-fx-border-color: #cccccc; -fx-border-width: 1;" />
                                <!-- Ya no hay botón para cargar imagen -->
                            </children>
                        </VBox>

                        <!-- Datos de la credencial -->
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" prefWidth="160.0" />
                                <ColumnConstraints halignment="LEFT" prefWidth="320.0" />
                                <ColumnConstraints halignment="RIGHT" prefWidth="140.0" />
                                <ColumnConstraints halignment="LEFT" prefWidth="160.0" />
                        <ColumnConstraints halignment="LEFT" prefWidth="160.0" />
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                                <RowConstraints minHeight="30" />
                            </rowConstraints>

                            <children>
                                <!-- Matrícula + botón buscar -->
                                <Label text="Matrícula (No. control):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtMatricula" promptText="Ingrese matrícula" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Button onAction="#onBuscar" text="Buscar" textOverrun="CENTER_WORD_ELLIPSIS" GridPane.columnIndex="3" GridPane.columnSpan="2" />

                                <!-- Nombre -->
                                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <!-- Paterno -->
                                <Label text="Paterno:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtPaterno" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <!-- Materno -->
                                <Label text="Materno:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="txtMaterno" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <!-- CURP -->
                                <Label text="CURP:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="txtCurp" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <!-- NSS -->
                                <Label text="NSS:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <TextField fx:id="txtNss" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                <!-- Fecha de emisión -->
                                <Label text="Fecha de emisión:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                <DatePicker fx:id="dpFechaEmision" disable="true" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                <!-- Vigencia -->
                                <Label text="Vigencia:" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                                <TextField fx:id="txtVigencia" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                            </children>
                        </GridPane>
                    </children>
                </HBox>

                <!-- Código de barras -->
                <VBox spacing="5">
                    <children>
                        <Label text="Código de barras (matrícula):" />
                        <ImageView fx:id="imgBarcode" fitHeight="180" fitWidth="600" preserveRatio="true" smooth="true" />
                    </children>
                </VBox>

                <!-- Botones inferiores -->
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <children>
                        <Button onAction="#onGenerarPDF" text="Generar Credencial" />
                        <Button onAction="#onCancelar" text="Cancelar" />
                        <Button onAction="#onVolverMenu" text="Volver al menú" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- ===== PANE ANVERSO OCULTO (solo para generar imágenes) ===== -->
    <bottom>
        <StackPane fx:id="paneAnverso" managed="false" prefHeight="0" prefWidth="0" visible="false">
            <children>
                <!-- Fondo oficial del frente -->
                <ImageView fitHeight="560" fitWidth="1000" preserveRatio="false">
                    <image>
                        <!-- Ajusta el path al archivo real en resources -->
                        <Image url="@../credencial_enfrente.jpg" />
                    </image>
                </ImageView>

                <!-- Estos labels NO se ven, pero el controller los usa
                     para componer el anverso al generar el PDF -->
                <Label fx:id="lblNombreLinea1" layoutX="340" layoutY="265" />
                <Label fx:id="lblNombreLinea2" layoutX="340" layoutY="299" />
                <Label fx:id="lblCurp" layoutX="340" layoutY="365" />
                <Label fx:id="lblNss" layoutX="340" layoutY="420" />
                <Label fx:id="lblNoControl" layoutX="340" layoutY="470" />

                <!-- Código de barras sobre la plantilla (no visible en la UI) -->
                <ImageView fx:id="imgBarcodePlantilla" fitHeight="70" fitWidth="210" layoutX="80" layoutY="460" preserveRatio="true" />
            </children>
        </StackPane>
    </bottom>

</BorderPane>
