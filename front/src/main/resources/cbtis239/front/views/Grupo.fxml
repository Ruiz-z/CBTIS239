<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane prefHeight="640" prefWidth="1000" stylesheets="@/cbtis239/front/css/Grupo.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.GrupoController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:10 14;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Crear Grupos" />
        </StackPane>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding:18;">
            <!-- Formulario -->
            <GridPane hgap="14" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="160" />
                    <ColumnConstraints halignment="LEFT" minWidth="260" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="28" />
                    <RowConstraints minHeight="28" />
                    <RowConstraints minHeight="28" />
                </rowConstraints>

                <Label text="Nombre del grupo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombreGrupo" promptText="p. ej. 5A Programación" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Capacidad:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtCapacidad" promptText="número" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Especialidad:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbEspecialidad" prefWidth="260" promptText="Selecciona…" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <!-- Ícono -->
            <FontIcon iconLiteral="fas-users" iconSize="120" />

            <!-- Tabla -->
            <VBox alignment="CENTER" spacing="8" style="-fx-padding:0 8 0 8;">
                <Label style="-fx-font-weight:bold;" text="Grupos disponibles:" />
                <TableView fx:id="tablaGrupos" prefHeight="300" prefWidth="940">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="380" text="Nombre del Grupo" />
                        <TableColumn fx:id="colCapacidad" prefWidth="160" text="Capacidad" />
                        <TableColumn fx:id="colEspecialidad" prefWidth="380" text="Especialidad" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Botones -->
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#onRegistrar" styleClass="btn-primary" text="Registrar Grupo" />
                <Button onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: white;" styleClass="btn-secondary" text="Modificar" />
                <Button onAction="#onCancelar" style="-fx-background-color: #800000; -fx-text-fill:WHITE;" styleClass="btn-secondary" text="Cancelar" />
                <Button onAction="#onVolver" style="-fx-background-color: #800000;" styleClass="btn-danger" text="Volver a menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
