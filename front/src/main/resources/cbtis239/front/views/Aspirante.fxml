<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.AspiranteController">

    <top>
        <Label maxWidth="Infinity" style="-fx-background-color:#7a0a0a;-fx-text-fill:white;-fx-font-size:20px;-fx-padding:10 0 10 0;" text="Registro de Aspirante" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true">
            <content>
                <VBox fillWidth="true" spacing="18">
                    <padding>
                        <Insets bottom="16" left="16" right="16" top="16" />
                    </padding>

                    <!-- === FORMULARIO === -->
                    <GridPane hgap="14" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130" />
                            <ColumnConstraints hgrow="ALWAYS" />
                            <ColumnConstraints halignment="RIGHT" minWidth="130" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <!-- Datos generales -->
                        <Label text="Folio:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtFolio" onAction="#onBuscarFolio" promptText="Folio del aspirante" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="CURP:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCurp" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Apellido Paterno:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtPaterno" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Apellido Materno:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtMaterno" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Fecha de Nacimiento:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <DatePicker fx:id="dpFechaNac" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <Label text="NSS:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtNss" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Tipo de Sangre:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <ComboBox fx:id="cmbTipoSangre" GridPane.columnIndex="3" GridPane.rowIndex="3">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="A+" />
                                    <String fx:value="A-" />
                                    <String fx:value="B+" />
                                    <String fx:value="B-" />
                                    <String fx:value="AB+" />
                                    <String fx:value="AB-" />
                                    <String fx:value="O+" />
                                    <String fx:value="O-" />
                                </FXCollections>
                            </items>
                        </ComboBox>


                        <Label text="Altura (m):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtAltura" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Peso (kg):" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                        <TextField fx:id="txtPeso" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                        <!-- Contacto -->
                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                        <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="5" />

                        <Label text="Correo Aspirante:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <TextField fx:id="txtCorreoAspirante" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label text="Cel. Aspirante:" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                        <TextField fx:id="txtCelAspirante" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                        <!-- Lugar / dirección -->
                        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <TextField fx:id="txtEstado" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label text="Municipio:" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                        <TextField fx:id="txtMunicipio" GridPane.columnIndex="3" GridPane.rowIndex="7" />

                        <Label text="Localidad:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                        <TextField fx:id="txtLocalidad" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                        <Label text="Calle:" GridPane.columnIndex="2" GridPane.rowIndex="8" />
                        <TextField fx:id="txtCalle" GridPane.columnIndex="3" GridPane.rowIndex="8" />

                        <Label text="Número:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                        <TextField fx:id="txtNumero" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                        <Label text="Colonia:" GridPane.columnIndex="2" GridPane.rowIndex="9" />
                        <TextField fx:id="txtColonia" GridPane.columnIndex="3" GridPane.rowIndex="9" />

                        <!-- Padres y tutores -->
                        <Label text="Cel. Padre:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                        <TextField fx:id="txtCelPadre" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                        <Label text="Cel. Madre:" GridPane.columnIndex="2" GridPane.rowIndex="10" />
                        <TextField fx:id="txtCelMadre" GridPane.columnIndex="3" GridPane.rowIndex="10" />

                        <Label text="Contacto Emergencia:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
                        <TextField fx:id="txtContactoEmergencia" GridPane.columnIndex="1" GridPane.rowIndex="11" />

                        <Label text="Tutor 1:" GridPane.columnIndex="2" GridPane.rowIndex="11" />
                        <TextField fx:id="txtTutor1" GridPane.columnIndex="3" GridPane.rowIndex="11" />

                        <Label text="Tutor 2:" GridPane.columnIndex="0" GridPane.rowIndex="12" />
                        <TextField fx:id="txtTutor2" GridPane.columnIndex="1" GridPane.rowIndex="12" />

                        <!-- Datos académicos -->
                        <Label text="Dir.Secundaria:" GridPane.columnIndex="0" GridPane.rowIndex="13" />
                        <TextField fx:id="txtSecundaria" GridPane.columnIndex="1" GridPane.rowIndex="13" />

                        <Label text="Estado Sec.:" GridPane.columnIndex="2" GridPane.rowIndex="13" />
                        <TextField fx:id="txtEstadoSec" GridPane.columnIndex="3" GridPane.rowIndex="13" />

                        <Label text="Municipio Sec.:" GridPane.columnIndex="0" GridPane.rowIndex="14" />
                        <TextField fx:id="txtMunicipioSec" GridPane.columnIndex="1" GridPane.rowIndex="14" />

                        <Label text="Nombre Sec.:" GridPane.columnIndex="2" GridPane.rowIndex="14" />
                        <TextField fx:id="txtNombreSec" GridPane.columnIndex="3" GridPane.rowIndex="14" />

                        <Label text="Promedio Final:" GridPane.columnIndex="0" GridPane.rowIndex="15" />
                        <TextField fx:id="txtPromedio" GridPane.columnIndex="1" GridPane.rowIndex="15" />

                        <Label text="Calif. Examen Ingreso:" GridPane.columnIndex="2" GridPane.rowIndex="15" />
                        <TextField fx:id="txtCalificacion" GridPane.columnIndex="3" GridPane.rowIndex="15" />

                        <!-- Catálogos -->
                        <Label text="Edo. Civil:" GridPane.columnIndex="0" GridPane.rowIndex="16" />
                        <ComboBox fx:id="cmbEdoCivil" GridPane.columnIndex="1" GridPane.rowIndex="16" />

                        <Label text="Género:" GridPane.columnIndex="2" GridPane.rowIndex="16" />
                        <ComboBox fx:id="cmbGenero" GridPane.columnIndex="3" GridPane.rowIndex="16" />

                        <!-- Opciones de especialidad -->
                        <Label text="1ª Opción:" GridPane.columnIndex="0" GridPane.rowIndex="17" />
                        <ComboBox fx:id="cmbEsp1" GridPane.columnIndex="1" GridPane.rowIndex="17" />

                        <Label text="2ª Opción:" GridPane.columnIndex="2" GridPane.rowIndex="17" />
                        <ComboBox fx:id="cmbEsp2" GridPane.columnIndex="3" GridPane.rowIndex="17" />

                        <Label text="3ª Opción:" GridPane.columnIndex="0" GridPane.rowIndex="18" />
                        <ComboBox fx:id="cmbEsp3" GridPane.columnIndex="1" GridPane.rowIndex="18" />

                        <Label text="4ª Opción:" GridPane.columnIndex="2" GridPane.rowIndex="18" />
                        <ComboBox fx:id="cmbEsp4" GridPane.columnIndex="3" GridPane.rowIndex="18" />

                        <!-- Estatus -->
                        <Label text="Estatus Pago:" GridPane.columnIndex="0" GridPane.rowIndex="19" />
                        <ComboBox fx:id="cmbEstatusPago" GridPane.columnIndex="1" GridPane.rowIndex="19" />

                        <Label text="Estatus Inscripción:" GridPane.columnIndex="2" GridPane.rowIndex="19" />
                        <ComboBox fx:id="cmbEstatusInscripcion" GridPane.columnIndex="3" GridPane.rowIndex="19" />

                        <Label text="Fecha Registro:" GridPane.columnIndex="0" GridPane.rowIndex="20" />
                        <DatePicker fx:id="dpFechaReg" GridPane.columnIndex="1" GridPane.rowIndex="20" />
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>

                    <!-- === TABLA FIJA Y MÁS ALTA === -->
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 5 0 5 0;" text="Listado de Aspirantes" />

                    <TableView fx:id="tblAspirantes" maxHeight="700" minHeight="500" prefHeight="600" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFolio" prefWidth="100" text="Folio" />
                            <TableColumn fx:id="colNombre" prefWidth="200" text="Nombre" />
                            <TableColumn fx:id="colPaterno" prefWidth="200" text="Paterno" />
                            <TableColumn fx:id="colMaterno" prefWidth="200" text="Materno" />
                            <TableColumn fx:id="colEstatus" prefWidth="220" text="Estatus Inscripción" />
                        </columns>
                    </TableView>



                    <!-- === BOTONES === -->
                    <HBox alignment="CENTER" spacing="12">
                        <Button onAction="#onInscribir" style="-fx-background-color: #800000;" text="Inscribir" textFill="WHITE" />
                        <Button onAction="#onGuardar" style="-fx-background-color: #800000;" text="Guardar" textFill="WHITE" />
                        <Button onAction="#onModificar" style="-fx-background-color: #800000;" text="Modificar" textFill="WHITE" />
                        <Button onAction="#onEliminar" style="-fx-background-color: #800000;" text="Eliminar" textFill="#fcfcfc" />
                        <Button onAction="#onCancelar" style="-fx-background-color: #800000;" text="Cancelar" textFill="WHITE" />
                        <Button onAction="#onVolver" style="-fx-background-color: #800000;" text="Volver al Menú" textFill="WHITE" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
