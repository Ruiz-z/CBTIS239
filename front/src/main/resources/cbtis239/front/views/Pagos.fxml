<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.pagosController"
            stylesheets="@/cbtis239/front/css/pagos.css">

    <!-- 🔹 Barra superior -->
    <top>
        <StackPane styleClass="top-bar" prefHeight="60">
            <Label text="Pagos" styleClass="title-top"/>
        </StackPane>
    </top>

    <!-- 🔹 Contenido central -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER" styleClass="main-container">

            <!-- BUSCAR -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Buscar:" styleClass="subtitle"/>
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Matrícula o folio:"/>
                    <TextField fx:id="txtBusqueda" prefWidth="200"/>
                    <Button text="Registrar Pago" onAction="#onRegistrarPago"/>
                </HBox>
            </VBox>

            <!-- TABLA -->
            <TableView fx:id="tablaPagos" prefWidth="600" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colMonto" text="Monto" prefWidth="200"/>
                    <TableColumn fx:id="colPagado" text="Pagado" prefWidth="200"/>
                </columns>
            </TableView>

            <!-- BOTONES ABAJO -->
            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                <Button text="volver al menu" onAction="#onVolver" styleClass="btn-menu"/>

            </HBox>
        </VBox>
    </center>

</BorderPane>

