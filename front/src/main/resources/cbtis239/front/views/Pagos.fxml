<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@/cbtis239/front/css/pagos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.pagosController">

    <top>
        <StackPane prefHeight="60" style="-fx-background-color: #800000;" styleClass="top-bar">
            <Label styleClass="title-top" text="Pagos" />
        </StackPane>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="16" styleClass="main-container">
            <VBox alignment="CENTER_LEFT" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Matrícula o folio:" />
                    <TextField fx:id="txtBusqueda" prefWidth="220" />
                    <Button onAction="#onBuscar" style="-fx-background-color: #800000;" text="Buscar" textFill="WHITE" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Monto" />
                        <TextField fx:id="txtMonto" editable="false" prefWidth="100" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Periodo" />
                        <TextField fx:id="txtPeriodo" editable="false" prefWidth="160" />
                    </HBox>
                </HBox>
            </VBox>

            <TableView fx:id="tablaPagos" prefHeight="300" prefWidth="650">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="280" text="Nombre" />
                    <TableColumn fx:id="colMonto" prefWidth="180" text="Monto" />
                    <TableColumn fx:id="colPagado" prefWidth="160" text="Pagado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 10;">
                <Button onAction="#onRegistrarPago" style="-fx-background-color: #800000;" text="Registrar Pago" textFill="WHITE" />
                <Button onAction="#onCancelar" style="-fx-background-color: #800000;" styleClass="btn-cancelar" text="Cancelar" textFill="WHITE" />
                <Button onAction="#onVolver" style="-fx-background-color: #800000;" styleClass="btn-menu" text="volver al menu" textFill="WHITE" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
