<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="980" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.GeneroController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Géneros" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="380" prefWidth="420" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <VBox alignment="TOP_CENTER" spacing="15" GridPane.columnIndex="0">
<ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
    <image>
        <Image url="@/cbtis239/front/Genero.png" /> 
        </image>
</ImageView>

                <GridPane hgap="10" style="-fx-padding:10 0 0 0;" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Nombre de género:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnAgregar" onAction="#onAgregar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar" textFill="WHITE" />
                    <Button fx:id="btnModificar" onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Modificar" />
                    <Button fx:id="btnEliminar" onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Limpiar" />
                </HBox>

                <Region prefHeight="6" />
            </VBox>

            <VBox alignment="TOP_LEFT" spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-font-weight:bold; -fx-font-size:13;" text="Géneros registrados:" />
                <TableView fx:id="tabla" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="420" text="Nombre género" />
                        </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button onAction="#onVolverMenu" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Regresar al menú" />
        </HBox>
    </bottom>
</BorderPane>
