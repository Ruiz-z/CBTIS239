<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.HorarioGruposController">

    <top>
        <VBox spacing="0">
            <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
                <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Horario por Grupo" />
            </StackPane>

            <HBox spacing="12" style="-fx-padding:12 18;">
                <Label text="Especialidad:" />
                <ComboBox fx:id="cmbEspecialidad" prefWidth="280" />

                <Label text="Grupo:" />
                <ComboBox fx:id="cmbGrupo" prefWidth="220" />

                <Label text="Semestre:" />
                <Label fx:id="lblSemestre" style="-fx-font-weight:bold;" />

                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onVolverMenu" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="18" style="-fx-padding:12 18;">
                <!-- Retícula (8 pastillas) -->
                <TitledPane expanded="true" text="Retícula del semestre (verde = cubierta, rojo = pendiente, blanco = vacío)">
                    <content>
                        <FlowPane fx:id="paneReticula" hgap="10" prefWrapLength="900" style="-fx-padding:10;" vgap="10" />
                    </content>
                </TitledPane>

                <!-- Cursos seleccionados -->
                <TitledPane expanded="true" text="Cursos del grupo (inscritos)">
                    <content>
                        <VBox spacing="10">
                            <TableView fx:id="tblSeleccionados" prefHeight="220">
                                <columns>
                                    <TableColumn fx:id="colSelCheck" prefWidth="60" text="Sel." />
                                    <TableColumn fx:id="colSelMateria" prefWidth="220" text="Materia" />
                                    <TableColumn fx:id="colSelDocente" prefWidth="260" text="Docente" />
                                    <TableColumn fx:id="colSelHorario" text="Horario (Días de HH:MM a HH:MM en Aula)" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button onAction="#onQuitar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Quitar seleccionadas" />
                            </HBox>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- Cursos disponibles -->
                <TitledPane expanded="true" text="Cursos disponibles (según retícula)">
                    <content>
                        <VBox spacing="10">
                            <TableView fx:id="tblDisponibles" prefHeight="260">
                                <columns>
                                    <TableColumn fx:id="colDispCheck" prefWidth="60" text="Sel." />
                                    <TableColumn fx:id="colDispMateria" prefWidth="220" text="Materia" />
                                    <TableColumn fx:id="colDispDocente" prefWidth="260" text="Docente" />
                                    <TableColumn fx:id="colDispHorario" text="Horario (Días de HH:MM a HH:MM en Aula)" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button onAction="#onAgregar" style="-fx-background-color:#800000; -fx-text-fill:white; -fx-font-weight:bold;" text="Agregar seleccionadas" />
                                <Button onAction="#onGenerarAuto" style="-fx-background-color:#800000; -fx-text-fill:white; -fx-font-weight:bold;" text="Generar automáticamente" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onMoverAlumnoAlGrupoActual" text="Mover alumno al grupo actual" />
                            </HBox>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
