<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550" prefWidth="800" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.RolesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#800000;">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <Label style="-fx-font-size:18px; -fx-text-fill:white; -fx-font-weight:bold;" text="Crear Roles" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding:20;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="400" />
                </columnConstraints>

                <children>
                    <Label text="Nombre Rol:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtNombre" promptText="Ej. Servicios Escolares" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextArea fx:id="txtDescripcion" prefRowCount="3" promptText="Funciones o permisos del rol" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <TableView fx:id="tblRoles" prefHeight="280">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre Rol" />
                    <TableColumn fx:id="colDescripcion" prefWidth="360" text="Descripción" />
                    </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER" spacing="10">
                <children>
                    <Button fx:id="btnGuardar" onAction="#onGuardar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
                    <Button fx:id="btnActualizar" onAction="#onActualizar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" style="-fx-background-color: #800000; -fx-text-fill: White; -fx-font-weight: bold;" text="Limpiar" />
                    <Button fx:id="btnEliminar" onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                    <Button fx:id="btnVolver" onAction="#onVolverMenu" style="-fx-background-color:#800000; -fx-text-fill:white; -fx-font-weight:bold;" text="Volver al Menú" />
                </children>
            </HBox>
        </VBox>
    </center>
</BorderPane>
