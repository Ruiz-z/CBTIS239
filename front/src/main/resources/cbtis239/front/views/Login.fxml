<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>

<BorderPane prefHeight="440" prefWidth="760" style="-fx-background-color: #f2f3f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.LoginController">

  <!-- 🔴 Encabezado -->
  <top>
    <HBox alignment="CENTER" style="-fx-background-color:#800000;">
      <padding><Insets bottom="12" left="10" right="10" top="12" /></padding>
      <Label style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:16px;" text="CBTIS 239" />
    </HBox>
  </top>

  <!-- ⚪ Contenido -->
  <center>
    <VBox alignment="CENTER" spacing="25">
      <padding><Insets bottom="20" left="40" right="40" top="20" /></padding>

      <!-- 🦉 Logo -->
      <ImageView fitWidth="130" preserveRatio="true" smooth="true">
        <image>
          <!-- Ajusta la ruta según la ubicación real de tu imagen -->
          <Image url="@/cbtis239/front/img.png" />
        </image>
      </ImageView>

      <!-- 🧾 Formulario centrado -->
      <GridPane alignment="CENTER" hgap="10" vgap="18">
        <columnConstraints>
          <ColumnConstraints halignment="RIGHT" minWidth="100" />
          <ColumnConstraints halignment="LEFT" prefWidth="250" />
        </columnConstraints>

        <children>
          <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
          <TextField fx:id="txtUser" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0" />

          <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
          <PasswordField fx:id="txtPass" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1" />

          <!-- Campo visible (compatibilidad con controlador) -->
          <TextField fx:id="txtPassVisible" managed="false" prefWidth="240" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

          <CheckBox fx:id="chkMostrar" managed="false" text="Mostrar contraseña" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
      </GridPane>

      <!-- 🔘 Botones (centrados y separados) -->
      <HBox alignment="CENTER" spacing="25">
        <Button fx:id="btnEntrar" onAction="#onEntrar" prefHeight="32" prefWidth="140" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Iniciar Sesión" />
        <Button fx:id="btnSalir" onAction="#onSalir" prefHeight="32" prefWidth="100" style="-fx-background-color: #800000; -fx-text-fill: Withe; -fx-font-weight: bold; -fx-background-radius: 6;" text="Salir">
               <textFill>
                  <RadialGradient centerX="0.5" centerY="0.5" radius="0.5">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </RadialGradient>
               </textFill></Button>
      </HBox>

      <!-- 🔵 Estado -->
      <Label fx:id="lblEstado" style="-fx-text-fill:#6b7280; -fx-font-size:12px;" text="" />
    </VBox>
  </center>
</BorderPane>
