<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.KardexController">

    <!-- BARRA SUPERIOR -->
 <top>
    <StackPane style="-fx-background-color:#7A0B0B;">
        <padding>
            <Insets bottom="12" left="18" right="18" top="12" />
        </padding>
        <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="KARDEX ACADÉMICO" />
    </StackPane>
</top>


    <center>
        <VBox spacing="18">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <!-- BUSCAR ALUMNO -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Matrícula:" />
                <TextField fx:id="txtMatricula" prefWidth="180" promptText="Ej. 19305052390027" />
                <Button onAction="#onBuscar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Buscar" />
                <Button onAction="#onGenerarPDF" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Generar PDF" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onVolverMenu" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
            </HBox>

            <!-- DATOS DEL ALUMNO -->
            <GridPane hgap="10" vgap="6">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                    <ColumnConstraints halignment="RIGHT" minWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblNombre" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="CURP:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label fx:id="lblCurp" text="—" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Carrera:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblCarrera" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Promedio general:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="lblPromedio" text="—" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Avance créditos:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="lblAvanceCreditos" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- TABLA KARDEX -->
            <TableView fx:id="tblKardex" prefHeight="420">
                <columns>
                    <TableColumn fx:id="colPlantel" prefWidth="140" text="Nombre Plantel" />
                    <TableColumn fx:id="colTipoUac" prefWidth="80" text="Tipo UAC" />
                    <TableColumn fx:id="colClaveUac" prefWidth="110" text="Clave UAC" />
                    <TableColumn fx:id="colSemestre" prefWidth="70" text="Semestre" />
                    <TableColumn fx:id="colNombreUac" prefWidth="350" text="Nombre" />
                    <TableColumn fx:id="colCalif" prefWidth="70" text="Calif" />
                    <TableColumn fx:id="colCreditos" prefWidth="80" text="Créditos" />
                    <TableColumn fx:id="colPeriodo" prefWidth="160" text="Periodo Escolar" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>
