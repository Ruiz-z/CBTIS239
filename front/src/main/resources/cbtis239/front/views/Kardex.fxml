<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.KardexController"
            prefWidth="1100" prefHeight="650">

    <!-- BARRA SUPERIOR -->
 <top>
    <StackPane style="-fx-background-color:#7A0B0B;">
        <padding>
            <Insets top="12" right="18" bottom="12" left="18"/>
        </padding>
        <Label text="KARDEX ACADÉMICO"
               style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
    </StackPane>
</top>


    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- BUSCAR ALUMNO -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Matrícula:"/>
                <TextField fx:id="txtMatricula" prefWidth="180" promptText="Ej. 19305052390027"/>
                <Button text="Buscar" onAction="#onBuscar"
                        style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-font-weight:bold;"/>
                <Button text="Generar PDF" onAction="#onGenerarPDF"
                        style="-fx-background-color:#28a745; -fx-text-fill:white; -fx-font-weight:bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver al menú" onAction="#onVolverMenu"
                        style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </HBox>

            <!-- DATOS DEL ALUMNO -->
            <GridPane hgap="10" vgap="6">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblNombre" text="—"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="CURP:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Label fx:id="lblCurp" text="—"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Carrera:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblCarrera" text="—"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Promedio general:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label fx:id="lblPromedio" text="—"
                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Avance créditos:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="lblAvanceCreditos" text="—"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- TABLA KARDEX -->
            <TableView fx:id="tblKardex" prefHeight="420">
                <columns>
                    <TableColumn fx:id="colPlantel"    text="Nombre Plantel" prefWidth="140"/>
                    <TableColumn fx:id="colTipoUac"    text="Tipo UAC"       prefWidth="80"/>
                    <TableColumn fx:id="colClaveUac"   text="Clave UAC"      prefWidth="110"/>
                    <TableColumn fx:id="colSemestre"   text="Semestre"       prefWidth="70"/>
                    <TableColumn fx:id="colNombreUac"  text="Nombre"         prefWidth="350"/>
                    <TableColumn fx:id="colCalif"      text="Calif"          prefWidth="70"/>
                    <TableColumn fx:id="colCreditos"   text="Créditos"       prefWidth="80"/>
                    <TableColumn fx:id="colPeriodo"    text="Periodo Escolar" prefWidth="160"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>
