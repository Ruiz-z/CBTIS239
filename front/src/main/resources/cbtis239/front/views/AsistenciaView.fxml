<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.AsistenciaController">

    <children>
        <VBox spacing="10" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- BARRA SUPERIOR ROJA -->
            <children>
                <HBox prefHeight="70.0" spacing="10" style="-fx-background-color: #b40001; -fx-padding: 10;">
                    <children>
                        <!-- Si tienes logo, descomenta y ajusta la ruta -->
                        <!--
                        <ImageView fx:id="imgLogo"
                                   fitHeight="50.0" fitWidth="70.0"
                                   preserveRatio="true"/>
                        -->

                        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Entrada / Salida" />
                    </children>
                </HBox>

                <!-- CONTENIDO PRINCIPAL -->
                <HBox spacing="25" style="-fx-padding: 20;">
                    <children>

                        <!-- FOTO DEL ALUMNO -->
                        <VBox spacing="10">
                            <children>
                                <ImageView fx:id="imgAlumno" fitHeight="260.0" fitWidth="260.0" preserveRatio="true" style="-fx-border-color: black; -fx-border-width: 1; -fx-background-color: white;" />
                                <Label alignment="CENTER" maxWidth="260" style="-fx-font-size: 12px; -fx-text-fill: #555555;" text="Fotografía del alumno" />
                            </children>
                        </VBox>

                        <!-- DATOS -->
                        <GridPane hgap="10" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="260.0" />
                                <ColumnConstraints halignment="RIGHT" minWidth="60.0" />
                                <ColumnConstraints halignment="RIGHT" minWidth="60.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="130.0" />
                            </columnConstraints>

                            <children>
                                <!-- Matrícula -->
                                <Label text="Matrícula del alumno:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtMatricula" promptText="Escanee o escriba la matrícula" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <!-- Nombre -->
                                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" editable="false" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />

                                <!-- Fecha -->
                                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtFecha" editable="false" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <!-- Hora -->
                                <Label text="Hora:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <TextField fx:id="txtHora" editable="false" prefWidth="120" GridPane.columnIndex="4" GridPane.rowIndex="2" />
      
                              <Button fx:id="btnSalir" onAction="#onSalir" style="-fx-font-weight: bold;" text="Salir" GridPane.columnIndex="4" GridPane.rowIndex="5" />
                            </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </children>
                </HBox>

                <!-- MENSAJE -->
                <Label fx:id="lblMensaje" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b40001; -fx-padding: 5 0 15 0;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
