<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane stylesheets="@/cbtis239/front/css/menu.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.Menu2Controller">

    <!-- ===================== -->
    <!-- TOPBAR -->
    <!-- ===================== -->
    <top>
        <StackPane alignment="CENTER" prefHeight="50" styleClass="topbar">
            <Label styleClass="topbar-title" text="Menú Servicios Escolares 2" />
        </StackPane>
    </top>

    <!-- ===================== -->
    <!-- SIDEBAR (con tu CSS real) -->
    <!-- ===================== -->
               <!-- BOTONES DEL MENÚ -->
    <left>
        <StackPane>
            <VBox prefWidth="220" spacing="8" styleClass="sidebar" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

                <fx:define>
                    <ToggleGroup fx:id="menuGroup" />
                </fx:define>

                <!-- ===== BOTONES PRINCIPALES ===== -->

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openExpediente" styleClass="nav-btn" text="Expediente" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-clipboard" iconSize="20" /></graphic>
               <toggleGroup>
                  <ToggleGroup fx:id="menuGroup" />
               </toggleGroup>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openDocente" styleClass="nav-btn" text="Docente" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-chalkboard-teacher" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openCursos" styleClass="nav-btn" text="Cursos" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-book" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openCredencial" styleClass="nav-btn" text="Credencial" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-credit-card" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openGrupo" styleClass="nav-btn" text="Grupo" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openAsignatura" styleClass="nav-btn" text="Asignatura" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-book-open" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openAulas" styleClass="nav-btn" text="Aulas" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-user-friends" iconSize="20" /></graphic>
                </ToggleButton>


                <Region VBox.vgrow="ALWAYS" />

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openMenu3" styleClass="nav-btn" text="Más opciones" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-arrow-right" iconSize="20" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#onVolver" styleClass="nav-btn" text="Volver" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-arrow-left" iconSize="20" /></graphic>
                </ToggleButton>

                <!-- 🔥 Espaciador que empuja 'Cerrar sesión' al fondo -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- CERRAR SESIÓN -->
                <ToggleButton contentDisplay="LEFT" onAction="#onCerrarSesion" styleClass="nav-btn" text="Cerrar sesión">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="20" /></graphic>
                </ToggleButton>

            </VBox>
        </StackPane>
    </left>


    <!-- ===================== -->
    <!-- CONTENIDO CENTRAL -->
    <!-- ===================== -->
    <!-- CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content">
            <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 40;" VBox.vgrow="ALWAYS">

                <!-- 🔹 Texto actualizado -->
                <Label fx:id="lblBienvenida" style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="welcome-title" text="" />


                <ImageView fx:id="imgMenu" fitHeight="560" fitWidth="560" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@/cbtis239/front/Menu.png" />
                    </image>
                </ImageView>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
