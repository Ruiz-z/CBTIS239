<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="980" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.AulaController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Aulas" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="380" prefWidth="420" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Izquierda -->
            <VBox alignment="TOP_CENTER" spacing="15" GridPane.columnIndex="0">
                <ImageView fitHeight="120" fitWidth="160" preserveRatio="true">
                    <image>
                        <Image url="@/cbtis239/front/Aula.png" />
                    </image>
                </ImageView>

                <GridPane hgap="10" style="-fx-padding:10 0 0 0;" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Clave del Aula:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtClave" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Capacidad:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtCapacidad" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnAgregar" onAction="#onAgregar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar" />
                    <Button fx:id="btnModificar" onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Modificar" />
                    <Button fx:id="btnEliminar" onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                </HBox>

                <Region prefHeight="6" />
            </VBox>

            <!-- Derecha -->
            <VBox alignment="TOP_LEFT" spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-font-weight:bold; -fx-font-size:13;" text="Aulas registradas:" />
                <TableView fx:id="tblAulas" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colClave" prefWidth="220" text="Clave Aula" />
                        <TableColumn fx:id="colCapacidad" prefWidth="140" text="Capacidad" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button onAction="#onCancelar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Regresar al menú" />
        </HBox>
    </bottom>
</BorderPane>
