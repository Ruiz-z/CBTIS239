<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="980" stylesheets="@/cbtis239/front/css/Reticula.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.ReticulaController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Reticula" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="24" vgap="12">
            <padding><Insets bottom="18" left="22" right="22" top="18" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="280" prefWidth="320" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Filtros -->
            <VBox alignment="TOP_LEFT" spacing="12" GridPane.columnIndex="0">
                <ImageView fitHeight="140" fitWidth="140" preserveRatio="true">
                    <image><Image url="@/cbtis239/front/Reticula.png" /></image>
                </ImageView>

                <Label style="-fx-text-fill:#5c50cc; -fx-font-weight:bold;" text="Seleccione una especialidad:" />
                <ComboBox fx:id="cmbEspecialidad" />

                <Label style="-fx-text-fill:#5c50cc; -fx-font-weight:bold;" text="Semestre:" />
                <!-- null = Todos (para ver asignadas). Para agregar es obligatorio 1..12 -->
                <ComboBox fx:id="cmbSemestre" />

                <Region prefHeight="10" />
                <Button onAction="#onVolverMenu" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
            </VBox>

            <!-- Tablas -->
            <VBox spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-text-fill:#5c50cc; -fx-font-weight:bold;" text="Materias Disponibles:" />
                <TableView fx:id="tblDisponibles" prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colDispSel" prefWidth="50" text="Sel" />
                        <TableColumn fx:id="colDispClave" prefWidth="120" text="Clave" />
                        <TableColumn fx:id="colDispNombre" prefWidth="400" text="Nombre" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="12">
                    <Button onAction="#onAgregarSeleccionadas" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar seleccionadas" />
                    <Button onAction="#onQuitarSeleccionadas" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Quitar seleccionadas" />
                </HBox>

                <Label style="-fx-text-fill:#5c50cc; -fx-font-weight:bold;" text="Materias Asignadas" />
                <TableView fx:id="tblAsignadas" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colAsigSel" prefWidth="50" text="Sel" />
                        <TableColumn fx:id="colAsigClave" prefWidth="120" text="Clave" />
                        <TableColumn fx:id="colAsigNombre" prefWidth="320" text="Nombre" />
                        <TableColumn fx:id="colAsigSem" prefWidth="100" text="Semestre" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>
</BorderPane>
