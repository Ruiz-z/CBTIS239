<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="620" prefWidth="1080" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.CursoController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Creación de cursos" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="420" prefWidth="460" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Columna izquierda (Formulario) -->
            <VBox alignment="TOP_LEFT" spacing="12" GridPane.columnIndex="0">
                <ImageView fitHeight="140" fitWidth="180" preserveRatio="true">
                    <image><Image url="@/cbtis239/front/DocenteMateria.png" /></image>
                </ImageView>

                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="150" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Seleccione una materia:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox fx:id="cmbMateria" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Seleccione un docente:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cmbDocente" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Seleccione un Aula:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="cmbAula" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Periodo:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cmbPeriodo" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-font-weight:bold;" text="Horario:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <HBox spacing="18" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <VBox spacing="6">
                            <RadioButton fx:id="rbLV" text="Lunes a Viernes" />
                            <RadioButton fx:id="rbLJ" text="Lunes a Jueves" />
                        </VBox>
                        <VBox spacing="4">
                            <Label style="-fx-font-weight:bold;" text="Personalizar días:" />
                            <CheckBox fx:id="chkL" text="Lunes" />
                            <CheckBox fx:id="chkM" text="Martes" />
                            <CheckBox fx:id="chkX" text="Miércoles" />
                            <CheckBox fx:id="chkJ" text="Jueves" />
                            <CheckBox fx:id="chkV" text="Viernes" />
                        </VBox>
                    </HBox>

                    <Label text="Hora Inicio:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <ComboBox fx:id="cmbHoraIni" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label text="Hora Fin:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <ComboBox fx:id="cmbHoraFin" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label text="Descripción (auto):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <TextArea fx:id="txtDescripcion" editable="false" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="7" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <HBox spacing="10">
                    <Button onAction="#onCrear" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Crear Curso" />
                    <Button onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar Curso" />
                    <Button onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Modificar Curso" />
                    <Button onAction="#onLimpiar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Limpiar Campos" />
                </HBox>
            </VBox>

            <!-- Columna derecha (Tabla) -->
            <VBox alignment="TOP_LEFT" spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Cursos Disponibles:" />
                <TableView fx:id="tblCursos" prefHeight="460">
                    <columns>
                        <TableColumn fx:id="colMateria" prefWidth="230" text="Materia" />
                        <TableColumn fx:id="colDocente" prefWidth="260" text="Docente" />
                        <TableColumn fx:id="colAula" prefWidth="120" text="Aula" />
                        <TableColumn fx:id="colHorario" prefWidth="220" text="Horario" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button onAction="#onVolverMenu" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
        </HBox>
    </bottom>
</BorderPane>
