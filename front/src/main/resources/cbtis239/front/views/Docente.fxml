<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="980" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.DocenteController">

    <!-- =========== BARRA SUPERIOR =========== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Docentes" />
        </StackPane>
    </top>

    <!-- =========== CONTENIDO CENTRAL =========== -->
    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="430" prefWidth="450" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- ===== Columna izquierda: formulario ===== -->
            <VBox alignment="TOP_CENTER" spacing="15" GridPane.columnIndex="0">

                <!-- Imagen -->
                <ImageView fitHeight="140" fitWidth="160" preserveRatio="true">
                    <image>
                        <Image url="@/cbtis239/front/Docente.png" />
                    </image>
                </ImageView>

                <Label style="-fx-font-weight:bold; -fx-font-size:12;" text="Información del docente:" />

                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <!-- Datos personales -->
                    <Label text="CURP:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtCurp" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="NSS:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtNss" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Paterno:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="txtPaterno" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Materno:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <TextField fx:id="txtMaterno" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label text="Celular:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <TextField fx:id="txtCelular" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label text="Estado Civil:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <ComboBox fx:id="cmbEdoCivil" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                    <Label text="Género:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                    <ComboBox fx:id="cmbGenero" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                    <!-- Usuario / Contraseña -->
                    <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                    <TextField fx:id="txtUsuario" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                    <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
                    <PasswordField fx:id="txtPass" GridPane.columnIndex="1" GridPane.rowIndex="11" />

                    <Label text="Confirme contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="12" />
                    <PasswordField fx:id="txtPass2" GridPane.columnIndex="1" GridPane.rowIndex="12" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <!-- Botones CRUD -->
                <HBox alignment="CENTER" spacing="10">
                    <Button onAction="#onAgregar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar" />
                    <Button onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                    <Button onAction="#onModificar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Modificar" />
                </HBox>

            </VBox>

            <!-- ===== Columna derecha: tabla ===== -->
            <VBox alignment="TOP_LEFT" spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-font-weight:bold; -fx-font-size:13;" text="Docentes registrados:" />

                <TableView fx:id="tblDocentes" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colNombreCompleto" text="Nombre" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>

        </GridPane>
    </center>

    <!-- =========== BOTÓN INFERIOR =========== -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button onAction="#onCancelar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menu" />
        </HBox>
    </bottom>

</BorderPane>
