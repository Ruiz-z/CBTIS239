<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.DocenteController"
            prefWidth="980" prefHeight="560">

    <!-- =========== BARRA SUPERIOR =========== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label text="Docentes"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
        </StackPane>
    </top>

    <!-- =========== CONTENIDO CENTRAL =========== -->
    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="430" prefWidth="450"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- ===== Columna izquierda: formulario ===== -->
            <VBox spacing="15" GridPane.columnIndex="0" alignment="TOP_CENTER">

                <!-- Imagen -->
                <ImageView fitHeight="140" fitWidth="160" preserveRatio="true">
                    <image>
                        <Image url="@/cbtis239/front/Docente.png"/>
                    </image>
                </ImageView>

                <Label text="Información del docente:"
                       style="-fx-font-weight:bold; -fx-font-size:12;"/>

                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Datos personales -->
                    <Label text="CURP:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCurp" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Correo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCorreo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="NSS:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNss" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Nombre:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Paterno:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPaterno" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Materno:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtMaterno" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Teléfono:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtTelefono" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Celular:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCelular" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Estado Civil:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbEdoCivil" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <Label text="Género:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbGenero" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                    <!-- Usuario / Contraseña -->
                    <Label text="Usuario:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtUsuario" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

                    <Label text="Contraseña:" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="txtPass" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                    <Label text="Confirme contraseña:" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="txtPass2" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Botones CRUD -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Agregar" onAction="#onAgregar"
                            style="-fx-background-color:#28a745; -fx-text-fill:white; -fx-font-weight:bold;"/>
                    <Button text="Eliminar" onAction="#onEliminar"
                            style="-fx-background-color:#dc3545; -fx-text-fill:white; -fx-font-weight:bold;"/>
                    <Button text="Modificar" onAction="#onModificar"
                            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-font-weight:bold;"/>
                </HBox>

            </VBox>

            <!-- ===== Columna derecha: tabla ===== -->
            <VBox GridPane.columnIndex="1" spacing="10" alignment="TOP_LEFT">
                <Label text="Docentes registrados:"
                       style="-fx-font-weight:bold; -fx-font-size:13;"/>

                <TableView fx:id="tblDocentes" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colNombreCompleto" text="Nombre"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </GridPane>
    </center>

    <!-- =========== BOTÓN INFERIOR =========== -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button text="Cancelar"
                    onAction="#onCancelar"
                    style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-font-weight:bold;"/>
        </HBox>
    </bottom>

</BorderPane>
