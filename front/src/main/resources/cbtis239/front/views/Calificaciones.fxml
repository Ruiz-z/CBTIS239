<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.CalificacionesController"
            prefWidth="1080" prefHeight="640">

    <!-- =================== BARRA SUPERIOR =================== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B;">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>
            <Label text="Administración de Calificaciones (Docente)"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
        </StackPane>
    </top>

    <!-- =================== CONTENIDO PRINCIPAL =================== -->
    <center>
        <VBox spacing="22" alignment="TOP_CENTER">
            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>

            <!-- === Filtros de búsqueda === -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="LEFT" minWidth="100"/>
                </columnConstraints>

                <!-- 🔹 Fila 0: Selección de curso -->
                <Label text="Seleccione Curso:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbCurso" prefWidth="350"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Button text="Buscar"
                        onAction="#onBuscar"
                        GridPane.rowIndex="0" GridPane.columnIndex="2"
                        style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-font-weight:bold;"/>

                <!-- 🔹 Fila 1: Búsqueda por matrícula -->
                <Label text="Buscar Matrícula:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtBuscarMatricula"
                           promptText="Ej. 22050648"
                           onAction="#onBuscarPorMatricula"
                           prefWidth="200"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Button text="Filtrar"
                        onAction="#onBuscarPorMatricula"
                        GridPane.rowIndex="1" GridPane.columnIndex="2"
                        style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </GridPane>

<TableView fx:id="tblCalificaciones" prefHeight="400" editable="true">
    <columns>
        <TableColumn fx:id="colNombre"      text="Nombre Alumno"  prefWidth="250"/>
        <TableColumn fx:id="colMatricula"   text="Matrícula"      prefWidth="130"/>
        <TableColumn fx:id="colParcial1"    text="Parcial 1"      prefWidth="100"/>
        <TableColumn fx:id="colParcial2"    text="Parcial 2"      prefWidth="100"/>
        <TableColumn fx:id="colParcial3"    text="Parcial 3"      prefWidth="100"/>
        <TableColumn fx:id="colExamenFinal" text="Examen Final"   prefWidth="110"/>
        <TableColumn fx:id="colFinal"       text="Promedio"       prefWidth="120"/>
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
    </columnResizePolicy>
</TableView>


            <!-- === Promedio General === -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Promedio general del grupo:"/>
                <TextField fx:id="txtPromedioGeneral" prefWidth="100" editable="false"
                           style="-fx-background-color:#f0f0f0; -fx-font-weight:bold; -fx-alignment:center;"/>
            </HBox>

            <!-- === Botones de acción === -->
            <HBox spacing="18" alignment="CENTER">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <Button text="Cancelar" onAction="#onCancelar"
                        style="-fx-background-color:#ffc107; -fx-text-fill:black; -fx-font-weight:bold;"/>

                <Button text="Guardar" onAction="#onGuardar"
                        style="-fx-background-color:#28a745; -fx-text-fill:white; -fx-font-weight:bold;"/>

                <Button text="Finalizar" onAction="#onFinalizar"
                        style="-fx-background-color:#17a2b8; -fx-text-fill:white; -fx-font-weight:bold;"/>

                <Button text="Cerrar Sesion" onAction="#onCerrarSesion"
                        style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </HBox>
        </VBox>
    </center>

    <!-- =================== FONDO DECORATIVO OPCIONAL =================== -->
    <bottom>
        <StackPane alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Sistema Escolar CBTis 239 — Módulo Docente"
                   style="-fx-text-fill:gray; -fx-font-size:12;"/>
        </StackPane>
    </bottom>

</BorderPane>
