<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640" prefWidth="1080" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.CalificacionesController">

    <!-- =================== BARRA SUPERIOR =================== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B;">
            <padding>
                <Insets bottom="12" left="18" right="18" top="12" />
            </padding>
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Registro  de Calificaciones" />
        </StackPane>
    </top>

    <!-- =================== CONTENIDO PRINCIPAL =================== -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="22">
            <padding>
                <Insets bottom="22" left="22" right="22" top="22" />
            </padding>

            <!-- === Filtros de búsqueda === -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
                    <ColumnConstraints halignment="LEFT" minWidth="100" />
                </columnConstraints>

                <!-- 🔹 Fila 0: Selección de curso -->
                <Label text="Seleccione Curso:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbCurso" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Button onAction="#onBuscar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Buscar" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                <!-- 🔹 Fila 1: Búsqueda por matrícula -->
                <Label text="Buscar Matrícula:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtBuscarMatricula" onAction="#onBuscarPorMatricula" prefWidth="200" promptText="Ej. 22050648" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button onAction="#onBuscarPorMatricula" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Filtrar" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

<TableView fx:id="tblCalificaciones" editable="true" prefHeight="400">
    <columns>
        <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre Alumno" />
        <TableColumn fx:id="colMatricula" prefWidth="130" text="Matrícula" />
        <TableColumn fx:id="colParcial1" prefWidth="100" text="Parcial 1" />
        <TableColumn fx:id="colParcial2" prefWidth="100" text="Parcial 2" />
        <TableColumn fx:id="colParcial3" prefWidth="100" text="Parcial 3" />
        <TableColumn fx:id="colExamenFinal" prefWidth="110" text="Examen Final" />
        <TableColumn fx:id="colFinal" prefWidth="120" text="Promedio" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
</TableView>


            <!-- === Promedio General === -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Promedio general del grupo:" />
                <TextField fx:id="txtPromedioGeneral" editable="false" prefWidth="100" style="-fx-background-color:#f0f0f0; -fx-font-weight:bold; -fx-alignment:center;" />
            </HBox>

            <!-- === Botones de acción === -->
            <HBox alignment="CENTER" spacing="18">
                <padding>
                    <Insets bottom="12" left="12" right="12" top="12" />
                </padding>

                <Button onAction="#onCancelar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Cancelar" textFill="WHITE" />

                <Button onAction="#onGuardar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />

                <Button onAction="#onFinalizar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Finalizar" />

                <Button onAction="#onCerrarSesion" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Cerrar Sesion" />
            </HBox>
        </VBox>
    </center>

    <!-- =================== FONDO DECORATIVO OPCIONAL =================== -->
    <bottom>
        <StackPane alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Label style="-fx-text-fill:gray; -fx-font-size:12;" text="Sistema Escolar CBTis 239 — Módulo Docente" />
        </StackPane>
    </bottom>

</BorderPane>
