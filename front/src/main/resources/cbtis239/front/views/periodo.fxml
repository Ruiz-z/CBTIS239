<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="cbtis239.front.ui.users.PeriodoController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@/cbtis239/front/css/periodo.css"
            prefWidth="1100" prefHeight="650">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color:#7a0a0a;">
            <Label text="Periodos" style="-fx-text-fill:white;-fx-font-size:20px;-fx-padding:12 0 12 0;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="60" alignment="CENTER">

            <!-- Izquierda: imagen + formulario (sin ID de captura) -->
            <VBox spacing="25" alignment="TOP_CENTER" prefWidth="400">
                <padding><Insets top="30" right="5" bottom="0" left="5"/></padding>

                <ImageView fitHeight="120" fitWidth="120" preserveRatio="true" pickOnBounds="true">
                    <image>
                        <Image url="@/cbtis239/front/Calendario.png"/>
                    </image>
                </ImageView>

                <GridPane hgap="5" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                        <ColumnConstraints halignment="LEFT" minWidth="260"/>
                    </columnConstraints>

                    <Label text="Nombre periodo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Enero-Junio 2026"/>

                    <Label text="Fecha de inicio:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpInicio" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Fecha de fin:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpFin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Derecha: tabla -->
            <VBox spacing="15" alignment="CENTER">
                <TableView fx:id="tablaPeriodos" prefWidth="600" prefHeight="400">
                    <columns>
                        <TableColumn text="ID" fx:id="colId" prefWidth="80"/>
                        <TableColumn text="Nombre periodo" fx:id="colNombre" prefWidth="180"/>
                        <TableColumn text="Fecha Inicio" fx:id="colInicio" prefWidth="160"/>
                        <TableColumn text="Fecha Fin" fx:id="colFin" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox spacing="20" alignment="CENTER">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
            <Button text="Agregar" onAction="#onAgregar" prefWidth="120" prefHeight="40"/>
            <Button text="Modificar" onAction="#onModificar" prefWidth="120" prefHeight="40"/>
            <Button text="Eliminar" onAction="#onEliminar" prefWidth="120" prefHeight="40"/>
            <Button text="Cancelar" onAction="#onCancelar" prefWidth="120" prefHeight="40"/>
            <Button text="Volver al Menú" onAction="#onVolver" prefWidth="150" prefHeight="40"/>
        </HBox>
    </bottom>
</BorderPane>
