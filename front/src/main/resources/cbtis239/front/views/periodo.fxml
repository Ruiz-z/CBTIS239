<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="1100" stylesheets="@/cbtis239/front/css/periodo.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.PeriodoController">

    <top>
        <HBox alignment="CENTER" styleClass="topbar">
            <Label styleClass="topbar-title" text="Periodos" />
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="60">

            <VBox alignment="TOP_CENTER" prefWidth="400" spacing="25">
                <padding>
                    <Insets bottom="0" left="5" right="5" top="30" />
                </padding>

                <ImageView fx:id="imgCalendario" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@/cbtis239/front/Calendario.png" />
                    </image>
                </ImageView>

                <GridPane hgap="5" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120" />
                        <ColumnConstraints halignment="LEFT" minWidth="240" />
                    </columnConstraints>

                    <Label text="Nombre periodo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtNombre" prefHeight="32" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Fecha de inicio:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <DatePicker fx:id="dpInicio" prefHeight="32" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Fecha de fin:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <DatePicker fx:id="dpFin" prefHeight="32" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <VBox alignment="CENTER" spacing="15">
                <TableView fx:id="tablaPeriodos" prefHeight="400" prefWidth="600">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre periodo" />
                        <TableColumn fx:id="colInicio" prefWidth="160" text="Fecha Inicio" />
                        <TableColumn fx:id="colFin" prefWidth="160" text="Fecha Fin" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="16" left="20" right="20" top="16" />
            </padding>
            <Button fx:id="btnAgregar" onAction="#onAgregar" prefHeight="40" prefWidth="120" style="-fx-background-color: #800000;" styleClass="btn-primary" text="Agregar" />
            <Button fx:id="btnModificar" onAction="#onModificar" prefHeight="40" prefWidth="120" style="-fx-background-color: #800000;" styleClass="btn-secondary" text="Modificar" />
            <Button fx:id="btnEliminar" onAction="#onEliminar" prefHeight="40" prefWidth="120" style="-fx-background-color: #800000;" styleClass="btn-danger" text="Eliminar" />
            <Button fx:id="btnCancelar" onAction="#onCancelar" prefHeight="40" prefWidth="120" style="-fx-background-color: #800000;" styleClass="btn-cancel" text="Cancelar" />
            <Button fx:id="btnVolver" onAction="#onVolver" prefHeight="40" prefWidth="150" style="-fx-background-color: #800000;" styleClass="btn-danger" text="Volver al Menú" />
        </HBox>
    </bottom>
</BorderPane>
