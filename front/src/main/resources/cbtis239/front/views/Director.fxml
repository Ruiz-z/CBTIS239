<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="1200" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.DirectorController">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #c8102e;">
            <padding>
                <Insets bottom="18" left="30" right="20" top="18" />
            </padding>
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Configuración del Director" />
            </children>
        </HBox>
    </top>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>
            <children>

                <!-- TARJETA (FORMULARIO) MÁS ANCHA -->
                <VBox maxWidth="1085.0" prefHeight="563.0" prefWidth="1085.0" spacing="15" style="-fx-background-color: white;                              -fx-border-color: #dddddd;                              -fx-border-radius: 8;                              -fx-background-radius: 8;                              -fx-padding: 25;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 10, 0, 0, 3);">
                    <children>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25" />
                                <ColumnConstraints percentWidth="75" />
                            </columnConstraints>

                            <children>
                                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Apellido paterno:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtPaterno" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Apellido materno:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtMaterno" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Firma:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <children>
                                        <ImageView fx:id="imgFirma" fitHeight="140" fitWidth="320" preserveRatio="true" style="-fx-border-color: #cccccc; -fx-border-width: 1;" />
                                        <Button fx:id="btnCambiarFirma" onAction="#onCambiarFirma" style="-fx-background-color: #c8102e;                                                        -fx-text-fill: white;                                                        -fx-font-weight: bold;" text="Cambiar firma..." />
                                    </children>
                                </VBox>
                            </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </children>
                </VBox>

                <!-- BOTONES DEBAJO DE LA TARJETA, ALINEADOS A LA DERECHA -->
                <HBox alignment="CENTER_RIGHT" maxWidth="900" spacing="10">
                    <padding>
                        <Insets bottom="0" left="0" right="0" top="5" />
                    </padding>
                    <children>
                        <Button fx:id="btnGuardar" onAction="#onGuardar" style="-fx-background-color: #c8102e;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="Guardar" />


                        <Button fx:id="btnVolverMenu" onAction="#onVolverMenu" style="-fx-background-color: #c8102e;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="Volver al Menú" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

    <!-- MENSAJE DE ESTADO -->
    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10" left="30" right="20" top="5" />
            </padding>
            <children>
                <Label fx:id="lblMensaje" style="-fx-font-size: 13px;" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
