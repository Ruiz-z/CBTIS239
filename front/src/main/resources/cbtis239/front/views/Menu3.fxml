<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane stylesheets="@/cbtis239/front/css/menu.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.Menu3Controller">

    <!-- TOP BAR -->
    <top>
        <StackPane alignment="CENTER" prefHeight="50" styleClass="topbar">
            <Label styleClass="topbar-title" text="Menú Servicios Escolares 3" />
        </StackPane>
    </top>

    <!-- SIDEBAR -->
    <left>
        <StackPane>
            <VBox prefWidth="190" spacing="8" styleClass="sidebar" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

                <fx:define>
                    <ToggleGroup fx:id="menuGroup" />
                </fx:define>

                <!-- BOTONES PRINCIPALES (crecen con VBox.vgrow="ALWAYS") -->

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openEspecialidad" styleClass="nav-btn" text="Especialidad" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-graduation-cap" iconSize="18" /></graphic>
               <toggleGroup>
                  <ToggleGroup fx:id="menuGroup" />
               </toggleGroup>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openPeriodo" styleClass="nav-btn" text="Periodo" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-calendar-alt" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openReticula" styleClass="nav-btn" text="Retículas" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-book-open" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openEdoCivil" styleClass="nav-btn" text="Estado Civil" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-ring" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openGenero" styleClass="nav-btn" text="Género" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-venus-mars" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openDocenteMateria" styleClass="nav-btn" text="Asignar Materias" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-book" iconSize="18" /></graphic>
                </ToggleButton>
                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openDirector" styleClass="nav-btn" text="Director" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-user-tie" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#openBoletaCalificaciones" styleClass="nav-btn" text="Boleta de Calificaciones" toggleGroup="$menuGroup" VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-user-tie" iconSize="18" /></graphic>
                </ToggleButton>

                <!--<ToggleButton text="Kardex" toggleGroup="$menuGroup"
                              onAction="#openKardex"
                              styleClass="nav-btn"
                              contentDisplay="LEFT" graphicTextGap="10"
                              VBox.vgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fas-user-tie" iconSize="18"/></graphic>
                </ToggleButton>-->


                <!-- Espaciador para empujar 'Volver' hacia abajo -->
                <Region VBox.vgrow="ALWAYS" />

                <ToggleButton contentDisplay="LEFT" graphicTextGap="10" onAction="#onVolver" styleClass="nav-btn" text="Volver" toggleGroup="$menuGroup">
                    <graphic><FontIcon iconLiteral="fas-arrow-left" iconSize="18" /></graphic>
                </ToggleButton>

                <ToggleButton contentDisplay="LEFT" onAction="#onCerrarSesion" styleClass="nav-btn" text="Cerrar sesión">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="20" /></graphic>
                </ToggleButton>

            </VBox>
        </StackPane>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content">
            <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 40;" VBox.vgrow="ALWAYS">

                <!-- 🔹 Texto actualizado -->
                <Label fx:id="lblBienvenida" style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="welcome-title" text="" />


                <ImageView fx:id="imgMenu" fitHeight="286.0" fitWidth="363.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Menu.png" />
               </image>
                </ImageView>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
