<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.DocenteMateriaController"
            prefWidth="980" prefHeight="560">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label text="Asignar materias a docentes"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
        </StackPane>
    </top>

    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="380" prefWidth="420"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Columna izquierda -->
            <VBox spacing="15" GridPane.columnIndex="0" alignment="TOP_CENTER">
                <ImageView fitHeight="140" fitWidth="180" preserveRatio="true">
                    <image><Image url="@/cbtis239/front/DocenteMateria.png"/></image>
                </ImageView>

                <VBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding:10 0 0 0;">
                    <Label text="Seleccione un docente:" style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbDocente" prefWidth="260"/>

                    <Label text="Seleccione una materia:" style="-fx-text-fill:#5e44d8; -fx-font-weight:bold; -fx-padding:10 0 0 0;"/>
                    <ComboBox fx:id="cmbMateria" prefWidth="260"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10 0 0 0;">
                    <Button text="Asignar Materia" onAction="#onAsignar"
                            style="-fx-background-color:#28a745; -fx-text-fill:white; -fx-font-weight:bold;"/>
                    <Button text="Eliminar Relación" onAction="#onEliminar"
                            style="-fx-background-color:#dc3545; -fx-text-fill:white; -fx-font-weight:bold;"/>
                </HBox>
            </VBox>

            <!-- Columna derecha -->
            <VBox GridPane.columnIndex="1" spacing="10" alignment="TOP_LEFT">
                <Label text="Materias impartidas por docentes:" style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;"/>
                <TableView fx:id="tblRelaciones" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colDocente" text="Docente" prefWidth="380"/>
                        <TableColumn fx:id="colMateria" text="Materia" prefWidth="320"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button text="Volver al menú" onAction="#onCancelar"
                    style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-font-weight:bold;"/>
        </HBox>
    </bottom>
</BorderPane>
