<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="980" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.DocenteMateriaController">

    <top>
        <StackPane style="-fx-background-color:#7A0B0B; -fx-padding:12 18;">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Asignar materias a docentes" />
        </StackPane>
    </top>

    <center>
        <GridPane hgap="28" vgap="0">
            <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="380" prefWidth="420" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Columna izquierda -->
            <VBox alignment="TOP_CENTER" spacing="15" GridPane.columnIndex="0">
                <ImageView fitHeight="140" fitWidth="180" preserveRatio="true">
                    <image><Image url="@/cbtis239/front/DocenteMateria.png" /></image>
                </ImageView>

                <VBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding:10 0 0 0;">
                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Seleccione un docente:" />
                    <ComboBox fx:id="cmbDocente" prefWidth="260" />

                    <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold; -fx-padding:10 0 0 0;" text="Seleccione una materia:" />
                    <ComboBox fx:id="cmbMateria" prefWidth="260" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:10 0 0 0;">
                    <Button onAction="#onAsignar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Asignar Materia" />
                    <Button onAction="#onEliminar" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar Relación" />
                </HBox>
            </VBox>

            <!-- Columna derecha -->
            <VBox alignment="TOP_LEFT" spacing="10" GridPane.columnIndex="1">
                <Label style="-fx-text-fill:#5e44d8; -fx-font-weight:bold;" text="Materias impartidas por docentes:" />
                <TableView fx:id="tblRelaciones" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colDocente" prefWidth="380" text="Docente" />
                        <TableColumn fx:id="colMateria" prefWidth="320" text="Materia" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 22;">
            <Button onAction="#onVolver" style="-fx-background-color: #800000; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
        </HBox>
    </bottom>
</BorderPane>
