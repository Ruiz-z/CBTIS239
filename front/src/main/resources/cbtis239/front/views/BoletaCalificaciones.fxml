<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640" prefWidth="1080" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cbtis239.front.ui.users.BoletaCalificacionesController">

    <!-- ========== TOP: Título ========== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B;">
            <padding>
                <Insets bottom="12" left="18" right="18" top="12" />
            </padding>
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Boleta de calificaciones" />
        </StackPane>
    </top>

    <!-- ========== CENTER ========== -->
    <center>
        <BorderPane>
            <!-- Lado izquierdo: búsqueda -->
            <left>
                <VBox spacing="10">
                    <padding>
                        <Insets bottom="20" left="40" right="20" top="40" />
                    </padding>

                    <Label style="-fx-text-fill: black; -fx-font-size: 16; -fx-font-weight: bold;" text="Buscar alumno" textFill="#1e0101" />

                    <Label text="Matrícula:" />
                    <TextField fx:id="txtMatricula" prefWidth="180" />

                    <Button onAction="#onBuscar" prefWidth="120" style="-fx-background-color: #800000;" text="Buscar" textFill="WHITE" />
                </VBox>
            </left>

            <!-- Centro: tabla + resumen asistencia -->
            <center>
                <VBox spacing="12">
                    <padding>
                        <Insets bottom="20" left="20" right="40" top="30" />
                    </padding>

                    <Label style="-fx-font-weight:bold; -fx-font-size:14;" text="Calificaciones" />

                    <TableView fx:id="tblBoleta" prefHeight="360">
                        <columns>
                            <TableColumn fx:id="colCurso" prefWidth="380" text="Curso" />
                            <TableColumn fx:id="colParcial1" prefWidth="90" text="Parcial 1" />
                            <TableColumn fx:id="colParcial2" prefWidth="90" text="Parcial 2" />
                            <TableColumn fx:id="colParcial3" prefWidth="90" text="Parcial 3" />
                            <TableColumn fx:id="colExamenFinal" prefWidth="110" text="Examen Final" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- Resumen de asistencia -->
                    <TitledPane expanded="true" text="Resumen de asistencia (periodo actual)">
                        <content>
                            <GridPane hgap="10" vgap="6">
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10" />
                                </padding>

                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="220" />
                                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
                                </columnConstraints>

                                <Label text="Días de actividad escolar:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblDiasEscolares" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Días de asistencia del alumno:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblDiasAsistidos" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Porcentaje de asistencia:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblPorcentajeAsistencia" style="-fx-font-weight:bold;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                        </content>
                    </TitledPane>

                </VBox>
            </center>
        </BorderPane>
    </center>

    <!-- ========== BOTTOM: Botones ========== -->
    <bottom>
        <BorderPane>
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <left>
                <Button onAction="#onGenerarPDF" prefWidth="140" style="-fx-background-color: #800000;" text="Generar PDF" textFill="WHITE" />
            </left>

            <right>
                <Button onAction="#onVolverMenu" prefWidth="160" style="-fx-background-color: #800000;" text="Volver al menú" textFill="WHITE" />
            </right>
        </BorderPane>
    </bottom>

</BorderPane>
