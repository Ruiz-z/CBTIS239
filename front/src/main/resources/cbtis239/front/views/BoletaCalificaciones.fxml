<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cbtis239.front.ui.users.BoletaCalificacionesController"
            prefWidth="1080" prefHeight="640">

    <!-- ========== TOP: Título ========== -->
    <top>
        <StackPane style="-fx-background-color:#7A0B0B;">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>
            <Label text="Boleta de calificaciones"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
        </StackPane>
    </top>

    <!-- ========== CENTER ========== -->
    <center>
        <BorderPane>
            <!-- Lado izquierdo: búsqueda -->
            <left>
                <VBox spacing="10">
                    <padding>
                        <Insets top="40" right="20" bottom="20" left="40"/>
                    </padding>

                    <Label text="Buscar alumno"
                           style="-fx-text-fill:purple; -fx-font-size:16; -fx-font-weight:bold;"/>

                    <Label text="Matrícula:"/>
                    <TextField fx:id="txtMatricula" prefWidth="180"/>

                    <Button text="Buscar"
                            onAction="#onBuscar"
                            prefWidth="120"
                            style="-fx-background-color:#dddddd;"/>
                </VBox>
            </left>

            <!-- Centro: tabla + resumen asistencia -->
            <center>
                <VBox spacing="12">
                    <padding>
                        <Insets top="30" right="40" bottom="20" left="20"/>
                    </padding>

                    <Label text="Calificaciones"
                           style="-fx-font-weight:bold; -fx-font-size:14;"/>

                    <TableView fx:id="tblBoleta" prefHeight="360">
                        <columns>
                            <TableColumn fx:id="colCurso"       text="Curso"        prefWidth="380"/>
                            <TableColumn fx:id="colParcial1"    text="Parcial 1"    prefWidth="90"/>
                            <TableColumn fx:id="colParcial2"    text="Parcial 2"    prefWidth="90"/>
                            <TableColumn fx:id="colParcial3"    text="Parcial 3"    prefWidth="90"/>
                            <TableColumn fx:id="colExamenFinal" text="Examen Final" prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Resumen de asistencia -->
                    <TitledPane text="Resumen de asistencia (periodo actual)" expanded="true">
                        <content>
                            <GridPane hgap="10" vgap="6">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>

                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="220"/>
                                    <ColumnConstraints halignment="LEFT"  hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Días de actividad escolar:"
                                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="lblDiasEscolares" text="—"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Días de asistencia del alumno:"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="lblDiasAsistidos" text="—"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Porcentaje de asistencia:"
                                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lblPorcentajeAsistencia" text="—"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-font-weight:bold;"/>
                            </GridPane>
                        </content>
                    </TitledPane>

                </VBox>
            </center>
        </BorderPane>
    </center>

    <!-- ========== BOTTOM: Botones ========== -->
    <bottom>
        <BorderPane>
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <left>
                <Button text="Generar PDF"
                        onAction="#onGenerarPDF"
                        prefWidth="140"
                        style="-fx-background-color:#dddddd;"/>
            </left>

            <right>
                <Button text="Volver al menú"
                        onAction="#onVolverMenu"
                        prefWidth="160"
                        style="-fx-background-color:#dddddd;"/>
            </right>
        </BorderPane>
    </bottom>

</BorderPane>
